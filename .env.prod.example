# Production template. Copy to .env.prod and replace every placeholder.
# Use a separate Discord Application, Discord server and PostgreSQL volume from dev.
COMPOSE_PROJECT_NAME=foundry-marches-prod
APP_ENV=production

POSTGRES_PASSWORD=replace-with-a-unique-random-secret
POSTGRES_APP_PASSWORD=replace-with-another-unique-random-secret

# Must identify the production Foundry world; keep stable for this database volume.
FOUNDRY_WORLD_ID=00000000-0000-4000-8000-000000000002
FOUNDRY_WORLD_NAME=Foundry Marches Production
FOUNDRY_RELAY_BASE_URL=https://relay.example.com
FOUNDRY_RELAY_CLIENT_ID=replace-with-production-relay-client-id
FOUNDRY_RELAY_API_KEY=replace-with-production-relay-api-key
FOUNDRY_RELAY_SECRET_REF=env:FOUNDRY_RELAY_API_KEY
FOUNDRY_PUBLIC_BASE_URL=https://foundry.example.com
FOUNDRY_CHARACTER_DIAGNOSTICS=false

FOUNDRY_SYNC_API_TOKEN=replace-with-a-unique-random-token-at-least-32-characters
DISCORD_BOT_API_TOKEN=replace-with-a-different-unique-random-token-at-least-32-characters
FOUNDRY_SYNC_ENABLED=true
FOUNDRY_SYNC_INTERVAL_SECONDS=300

API_PORT=8081
DISCORD_BOT_TOKEN=replace-with-production-discord-bot-token
DISCORD_APPLICATION_ID=replace-with-production-application-id
DISCORD_GUILD_ID=replace-with-production-discord-server-id
# Required: comma-separated trusted Discord user IDs; at least one ID must be configured.
DISCORD_ADMIN_USER_IDS=
DISCORD_ADMIN_CHANNEL_ID=replace-with-private-production-admin-channel-id
DISCORD_CAMPAIGN_ROLE_ID=replace-with-production-campaign-role-id
DISCORD_HEALTH_INTERVAL_SECONDS=60
