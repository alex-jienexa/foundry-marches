  state "text" [not null, default: `'pending'`, note: "CHECK state IN ('pending', 'sent', 'failed')"]
  attempts "integer" [not null, default: `0`]
  last_error "text"
  delivered_at "timestamptz"
  created_at "timestamptz" [not null, default: `now()`]
  indexes {
    (notification_id, channel) [unique]
  }
  Note: "Canonical definition and PostgreSQL-specific indexes/constraints/triggers: tables.md#notification_deliveries; full functions and dynamic triggers: objects.md"
}

Table event_outbox {
  id "bigint" [pk, not null]
  kind "text" [not null]
  entity_type "text"
  entity_id "uuid"
  payload "jsonb" [not null, default: `'{}'`]
  created_at "timestamptz" [not null, default: `now()`]
  published_at "timestamptz"
  Note: "Canonical definition and PostgreSQL-specific indexes/constraints/triggers: tables.md#event_outbox; full functions and dynamic triggers: objects.md"
}

Table state_transitions {
  entity "text" [not null]
  from_state "text"
  to_state "text" [not null]
  indexes {
    (entity, from_state, to_state) [unique, note: "SQL UNIQUE NULLS NOT DISTINCT (not represented by DBML semantics)"]
  }
  Note: "Canonical definition and PostgreSQL-specific indexes/constraints/triggers: tables.md#state_transitions; full functions and dynamic triggers: objects.md"
}

