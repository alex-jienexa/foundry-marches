# Development environment template. Copy to .env.dev and keep it separate from production.
COMPOSE_PROJECT_NAME=foundry-marches-dev
APP_ENV=development
FOUNDRY_SYNC_ENABLED=true

# Generate both passwords with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-hex-secret
POSTGRES_APP_PASSWORD=replace-with-another-random-hex-secret

# Stable local world ID. Keep unchanged while retaining this database volume.
FOUNDRY_WORLD_ID=00000000-0000-4000-8000-000000000001
FOUNDRY_WORLD_NAME=Foundry Marches

# Existing self-hosted Foundry REST API Relay
FOUNDRY_RELAY_BASE_URL=https://relay.jiene.ru
FOUNDRY_RELAY_CLIENT_ID=replace-with-your-relay-client-id
FOUNDRY_RELAY_API_KEY=replace-with-your-relay-api-key
FOUNDRY_RELAY_SECRET_REF=env:FOUNDRY_RELAY_API_KEY

# Foundry server address for images
FOUNDRY_PUBLIC_BASE_URL=
# Show character calcuation diagnostics via logs
FOUNDRY_CHARACTER_DIAGNOSTICS=false

# Generate with: openssl rand -hex 32
FOUNDRY_SYNC_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters
# Automatic world refresh interval in seconds (30..86400; default 300).
FOUNDRY_SYNC_INTERVAL_SECONDS=300

# Optional host port for the API
API_PORT=8080

# Discord bot (create an application at https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=replace-with-the-bot-token
DISCORD_APPLICATION_ID=replace-with-the-application-id
DISCORD_GUILD_ID=replace-with-the-single-allowed-server-id
# Separate service-to-service credential; must differ from FOUNDRY_SYNC_API_TOKEN.
# Generate with: openssl rand -hex 32
DISCORD_BOT_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters
# Comma-separated trusted Discord user IDs that receive the owner role on /register.
DISCORD_ADMIN_USER_IDS=
# Optional private Discord channel for bot errors and integration health alerts.
# The bot needs View Channel, Send Messages and Embed Links permissions there.
DISCORD_ADMIN_CHANNEL_ID=
# Health polling interval in seconds (15..3600; default 60).
DISCORD_HEALTH_INTERVAL_SECONDS=60
# Discord role thats provides after registration
DISCORD_CAMPAIGN_ROLE_ID=